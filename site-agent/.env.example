# Copy to site-agent/.env (ignored by git)
PORT=3010
HOST=127.0.0.1

# Where the sites live: <SITES_ROOT>/<name>.wemeweb.com/current
SITES_ROOT=/var/www

# Origins of the BackOffice (comma separated)
ALLOWED_ORIGINS=https://backoffice.wemeweb.com

# Rura: each request's token is checked here
RURA_GRAPHQL_URL=https://api.wemeweb.com/graphql

# Optional: only these admins (_id from Rura) may manage sites; empty = every Rura admin
ALLOWED_ADMIN_IDS=

# Optional: more names that must not be created (comma separated)
EXTRA_RESERVED_NAMES=

# nginx: the agent writes one file per app here (the main file must `include` it) and reloads nginx
MANAGED_DIR=/etc/nginx/sites-available/managed
NGINX_MAIN_FILE=/etc/nginx/sites-available/wemeweb.com
# Ports an app can never point to (comma separated)
BLOCKED_PORTS=2376,3010

MAX_UPLOAD_MB=100
